fastlane_version "2.226.0"
default_platform(:ios)
require "base64"
require "fileutils"
require "shellwords"

class PrTestflightError < StandardError
  attr_reader :category

  def initialize(category, message)
    super(message)
    @category = category
  end
end

def prtf_state_start(state_name)
  UI.important("[PR_TESTFLIGHT][STATE=#{state_name}][START]")
end

def prtf_state_done(state_name)
  UI.success("[PR_TESTFLIGHT][STATE=#{state_name}][DONE]")
end

def prtf_project_root
  File.expand_path("..", __dir__)
end

def prtf_resolve_repo_path(path)
  return path if path.nil? || path.empty?
  return path if File.absolute_path(path) == path

  File.expand_path(path, prtf_project_root)
rescue StandardError
  path
end

def prtf_required_env!(env_key, category)
  value = ENV[env_key]
  return value unless value.nil? || value.strip.empty?

  raise PrTestflightError.new(category, "Missing required environment variable: #{env_key}")
end

def prtf_resolve_api_key_content(raw_value)
  normalized = raw_value.to_s.strip
  if normalized.include?("BEGIN PRIVATE KEY")
    return {
      key_content: normalized,
      is_key_content_base64: false,
      source: "raw-pem"
    }
  end

  begin
    decoded = Base64.strict_decode64(normalized)
    if decoded.include?("BEGIN PRIVATE KEY")
      return {
        key_content: normalized,
        is_key_content_base64: true,
        source: "base64-pem"
      }
    end
  rescue ArgumentError
    # Fall through and preserve original behavior (treat as base64 payload).
  end

  {
    key_content: normalized,
    is_key_content_base64: true,
    source: "base64-opaque"
  }
end

def prtf_build_asc_api_key(key_id:, issuer_id:, key_payload:)
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_payload[:key_content],
    is_key_content_base64: key_payload[:is_key_content_base64],
    duration: 1200
  )
rescue StandardError => error
  if key_payload[:is_key_content_base64] && error.message.to_s.downcase.include?("null byte")
    UI.important(
      "[PR_TESTFLIGHT][AUTH] ASC key parse failed as base64 (null byte); retrying with raw PEM interpretation"
    )
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_payload[:key_content],
      is_key_content_base64: false,
      duration: 1200
    )
  else
    raise
  end
end

def prtf_truthy_env?(env_key, default:)
  raw_value = ENV[env_key]
  return default if raw_value.nil? || raw_value.strip.empty?

  !%w[0 false no off].include?(raw_value.strip.downcase)
end

def prtf_api_key_pem_content(key_payload)
  return key_payload[:key_content] unless key_payload[:is_key_content_base64]

  Base64.strict_decode64(key_payload[:key_content])
rescue ArgumentError => error
  raise PrTestflightError.new(
    "auth",
    "APP_STORE_CONNECT_API_KEY_BASE64 must decode to App Store Connect key content: #{error.message}"
  )
end

def prtf_prepare_signing_auth_key!(context)
  return context if context[:dry_run]
  return context unless context[:signing_style] == "automatic"
  return context unless context[:allow_provisioning_updates]

  key_payload = context[:key_payload]
  return context if key_payload.nil?

  pem_content = prtf_api_key_pem_content(key_payload)
  auth_dir = File.join(context[:build_output_dir], "auth")
  FileUtils.mkdir_p(auth_dir)

  auth_key_path = File.join(auth_dir, "AuthKey_#{context[:api_key_id]}.p8")
  File.write(auth_key_path, pem_content)
  File.chmod(0o600, auth_key_path)

  context[:xcode_auth_key_path] = auth_key_path
  context
end

def prtf_cleanup(context)
  auth_key_path = context[:xcode_auth_key_path]
  return if auth_key_path.nil? || auth_key_path.strip.empty?
  return unless File.exist?(auth_key_path)

  File.delete(auth_key_path)
rescue StandardError => error
  UI.important("[PR_TESTFLIGHT][CLEANUP] Failed to remove temporary auth key file: #{error.message}")
end

def prtf_classify_error(error, fallback:)
  text = error.to_s.downcase

  return "auth" if [
    "app store connect",
    "authentication",
    "unauthorized",
    "forbidden",
    "invalid api key",
    "issuer",
    "401",
    "403"
  ].any? { |token| text.include?(token) }

  return "signing" if [
    "code signing",
    "provisioning profile",
    "no profiles for",
    "automatic signing is disabled",
    "cloud signing permission error",
    "no signing certificate",
    "signing certificate",
    "codesign",
    "requires a provisioning profile",
    "development team"
  ].any? { |token| text.include?(token) }

  return "upload" if [
    "pilot",
    "testflight",
    "transporter",
    "upload"
  ].any? { |token| text.include?(token) }

  return "build" if [
    "archive",
    "xcodebuild",
    "gym",
    "compile"
  ].any? { |token| text.include?(token) }

  fallback.to_s
end

def prtf_latest_gym_log_excerpt(max_files: 2, tail_bytes: 24_576)
  gym_logs_root = File.expand_path("~/Library/Logs/gym")
  return "" unless Dir.exist?(gym_logs_root)

  log_paths = Dir.glob(File.join(gym_logs_root, "**", "*.log"))
  return "" if log_paths.empty?

  excerpts = log_paths
    .sort_by { |path| File.mtime(path) }
    .reverse
    .take(max_files)
    .map do |path|
      contents = File.binread(path)
      excerpt = if contents.bytesize > tail_bytes
        contents.byteslice(contents.bytesize - tail_bytes, tail_bytes)
      else
        contents
      end

      "[#{File.basename(path)}]\n#{excerpt.encode("UTF-8", invalid: :replace, undef: :replace, replace: "")}"
    rescue StandardError
      nil
    end
    .compact

  excerpts.join("\n")
rescue StandardError
  ""
end

def prtf_refined_error_category(error, fallback:)
  initial_category = prtf_classify_error(error, fallback: fallback)
  return initial_category unless initial_category == "build"

  gym_excerpt = prtf_latest_gym_log_excerpt
  return initial_category if gym_excerpt.strip.empty?

  refined_category = prtf_classify_error("#{error}\n#{gym_excerpt}", fallback: fallback)
  if refined_category != initial_category
    UI.important(
      "[PR_TESTFLIGHT][CLASSIFIER] category_refined=#{initial_category}->#{refined_category} via gym log scan"
    )
  end
  refined_category
end

def prtf_validate_signing_style!(style)
  normalized = style.to_s.strip.downcase
  normalized = "automatic" if normalized.empty?
  return normalized if ["automatic", "manual"].include?(normalized)

  raise PrTestflightError.new("signing", "IOS_SIGNING_STYLE must be either 'automatic' or 'manual'")
end

def prtf_preflight_validation(context)
  xcodeproj = context[:xcodeproj]
  scheme = context[:scheme]
  unless File.exist?(xcodeproj)
    raise PrTestflightError.new("build", "Configured project file does not exist: #{xcodeproj}")
  end

  dry_run = ENV["PR_TESTFLIGHT_DRY_RUN"] == "1"
  context[:dry_run] = dry_run

  key_id = prtf_required_env!("APP_STORE_CONNECT_API_KEY_ID", "auth")
  issuer_id = prtf_required_env!("APP_STORE_CONNECT_ISSUER_ID", "auth")
  key_content = prtf_required_env!("APP_STORE_CONNECT_API_KEY_BASE64", "auth")
  key_payload = prtf_resolve_api_key_content(key_content)

  context[:api_key_id] = key_id
  context[:issuer_id] = issuer_id
  context[:key_payload] = key_payload

  context[:api_key] = if dry_run
    UI.important("[PR_TESTFLIGHT][AUTH] Dry-run mode active; skipping App Store Connect token generation")
    nil
  else
    UI.message(
      "[PR_TESTFLIGHT][AUTH] api_key_content_source=#{key_payload[:source]} base64=#{key_payload[:is_key_content_base64]}"
    )
    prtf_build_asc_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_payload: key_payload
    )
  end

  team_id = prtf_required_env!("APPLE_TEAM_ID", "signing")
  signing_style = prtf_validate_signing_style!(ENV["IOS_SIGNING_STYLE"] || "automatic")

  context[:team_id] = team_id
  context[:signing_style] = signing_style
  context[:allow_provisioning_updates] = prtf_truthy_env?("IOS_ALLOW_PROVISIONING_UPDATES", default: true)
  context[:manual_signing_fallback_ready] = false

  if signing_style == "manual"
    context[:provisioning_profile_specifier] = prtf_required_env!("IOS_PROVISIONING_PROFILE_SPECIFIER", "signing")
    context[:code_sign_identity] = prtf_required_env!("IOS_CODE_SIGN_IDENTITY", "signing")
  else
    fallback_profile = ENV["IOS_PROVISIONING_PROFILE_SPECIFIER"].to_s.strip
    fallback_identity = ENV["IOS_CODE_SIGN_IDENTITY"].to_s.strip

    if !fallback_profile.empty? && !fallback_identity.empty?
      context[:fallback_provisioning_profile_specifier] = fallback_profile
      context[:fallback_code_sign_identity] = fallback_identity
      context[:manual_signing_fallback_ready] = true
      UI.message("[PR_TESTFLIGHT][SIGNING] Manual-signing fallback is armed for signing-category archive failures")
    elsif !fallback_profile.empty? || !fallback_identity.empty?
      UI.important(
        "[PR_TESTFLIGHT][SIGNING] Ignoring partial manual fallback inputs; set both " \
        "IOS_PROVISIONING_PROFILE_SPECIFIER and IOS_CODE_SIGN_IDENTITY"
      )
    end
  end

  UI.message(
    "[PR_TESTFLIGHT][PRECHECK] project=#{xcodeproj} scheme=#{scheme} signing=#{signing_style} " \
    "allow_provisioning_updates=#{context[:allow_provisioning_updates]} " \
    "manual_fallback=#{context[:manual_signing_fallback_ready]} dry_run=#{dry_run}"
  )

  context
rescue PrTestflightError
  raise
rescue StandardError => error
  raise PrTestflightError.new(prtf_classify_error(error, fallback: "auth"), "Preflight failed: #{error.message}")
end

def prtf_version_build_prep(context)
  version = ENV["IOS_MARKETING_VERSION"]
  version = get_version_number(xcodeproj: context[:xcodeproj], target: context[:scheme]) if version.nil? || version.strip.empty?

  build_number = ENV["IOS_BUILD_NUMBER"]
  build_number = Time.now.utc.strftime("%Y%m%d%H%M") if build_number.nil? || build_number.strip.empty?

  context[:version] = version
  context[:build_number] = build_number

  context[:xcargs_common] = [
    "MARKETING_VERSION=#{version}",
    "CURRENT_PROJECT_VERSION=#{build_number}",
    "INFOPLIST_KEY_CFBundleShortVersionString=#{version}",
    "INFOPLIST_KEY_CFBundleVersion=#{build_number}",
    "DEVELOPMENT_TEAM=#{context[:team_id]}"
  ]

  if context[:signing_style] == "automatic" && context[:allow_provisioning_updates]
    context = prtf_prepare_signing_auth_key!(context)
  end

  UI.message("[PR_TESTFLIGHT][VERSION_BUILD_PREP] version=#{version} build=#{build_number}")

  context
rescue PrTestflightError
  raise
rescue StandardError => error
  raise PrTestflightError.new(prtf_classify_error(error, fallback: "build"), "Version/build prep failed: #{error.message}")
end

def prtf_signing_inputs_for_mode!(context, signing_style)
  return {} unless signing_style == "manual"

  profile = context[:provisioning_profile_specifier] || context[:fallback_provisioning_profile_specifier]
  identity = context[:code_sign_identity] || context[:fallback_code_sign_identity]

  if profile.nil? || profile.strip.empty? || identity.nil? || identity.strip.empty?
    raise PrTestflightError.new(
      "signing",
      "Manual signing requires IOS_PROVISIONING_PROFILE_SPECIFIER and IOS_CODE_SIGN_IDENTITY"
    )
  end

  {
    provisioning_profile_specifier: profile,
    code_sign_identity: identity
  }
end

def prtf_xcargs_for_signing_mode(context, signing_style, signing_inputs)
  xcargs = context[:xcargs_common].dup
  xcargs << "CODE_SIGN_STYLE=#{signing_style.capitalize}"

  if signing_style == "manual"
    xcargs << "PROVISIONING_PROFILE_SPECIFIER=#{signing_inputs[:provisioning_profile_specifier]}"
    xcargs << "CODE_SIGN_IDENTITY=#{signing_inputs[:code_sign_identity]}"
  elsif context[:allow_provisioning_updates]
    xcargs << "-allowProvisioningUpdates"

    if context[:xcode_auth_key_path]
      xcargs << "-authenticationKeyPath #{Shellwords.escape(context[:xcode_auth_key_path])}"
      xcargs << "-authenticationKeyID #{context[:api_key_id]}"
      xcargs << "-authenticationKeyIssuerID #{context[:issuer_id]}"
      UI.message("[PR_TESTFLIGHT][SIGNING] Automatic signing includes xcodebuild auth key flags")
    else
      UI.important("[PR_TESTFLIGHT][SIGNING] Automatic signing uses -allowProvisioningUpdates without auth key flags")
    end
  end

  xcargs.join(" ")
end

def prtf_export_options_for_signing_mode(context, signing_style, signing_inputs)
  export_options = {
    method: context[:export_method],
    signingStyle: signing_style,
    teamID: context[:team_id]
  }

  if signing_style == "manual"
    export_options[:provisioningProfiles] = {
      context[:app_identifier] => signing_inputs[:provisioning_profile_specifier]
    }
  end

  export_options
end

def prtf_archive_with_signing_mode(context, signing_style)
  signing_inputs = prtf_signing_inputs_for_mode!(context, signing_style)
  xcargs = prtf_xcargs_for_signing_mode(context, signing_style, signing_inputs)
  export_options = prtf_export_options_for_signing_mode(context, signing_style, signing_inputs)

  UI.message("[PR_TESTFLIGHT][ARCHIVE_BUILD] signing_style=#{signing_style}")

  gym(
    project: context[:xcodeproj],
    scheme: context[:scheme],
    configuration: "Release",
    clean: true,
    export_method: context[:export_method],
    export_options: export_options,
    output_directory: context[:build_output_dir],
    output_name: "#{context[:scheme]}-#{context[:build_number]}.ipa",
    xcargs: xcargs
  )

  ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
  if ipa_path.nil? || ipa_path.strip.empty?
    raise PrTestflightError.new("build", "Archive/build did not produce an IPA output path")
  end

  context[:ipa_path] = ipa_path
  context[:archive_signing_style] = signing_style
  context
end

def prtf_archive_build(context)
  if context[:dry_run]
    context[:ipa_path] = File.join(
      context[:build_output_dir],
      "#{context[:scheme]}-#{context[:build_number]}-dry-run.ipa"
    )
    UI.success("[PR_TESTFLIGHT][ARCHIVE_BUILD_COMPLETE] dry-run (no archive executed)")
    return context
  end

  context = prtf_archive_with_signing_mode(context, context[:signing_style])

  UI.success("[PR_TESTFLIGHT][ARCHIVE_BUILD_COMPLETE] ipa=#{context[:ipa_path]}")

  context
rescue PrTestflightError
  raise
rescue StandardError => error
  category = prtf_refined_error_category(error, fallback: "build")

  if category == "signing" && context[:signing_style] == "automatic" && context[:manual_signing_fallback_ready]
    UI.important(
      "[PR_TESTFLIGHT][SIGNING][FALLBACK] Automatic signing failed with category=signing; retrying archive with manual inputs"
    )

    begin
      context = prtf_archive_with_signing_mode(context, "manual")
      UI.success("[PR_TESTFLIGHT][SIGNING][FALLBACK] Archive succeeded using manual-signing fallback")
      UI.success("[PR_TESTFLIGHT][ARCHIVE_BUILD_COMPLETE] ipa=#{context[:ipa_path]}")
      return context
    rescue StandardError => fallback_error
      fallback_category = prtf_refined_error_category(fallback_error, fallback: "build")
      raise PrTestflightError.new(
        fallback_category,
        "Archive/build failed after automatic->manual signing retry: " \
        "automatic=#{error.message}; manual=#{fallback_error.message}"
      )
    end
  end

  raise PrTestflightError.new(category, "Archive/build failed: #{error.message}")
end

def prtf_upload_testflight(context)
  if context[:dry_run]
    UI.success("[PR_TESTFLIGHT][TESTFLIGHT_UPLOAD_COMPLETE] dry-run (no upload executed)")
    return context
  end

  pilot(
    api_key: context[:api_key],
    ipa: context[:ipa_path],
    skip_waiting_for_build_processing: true,
    distribute_external: false
  )

  UI.success("[PR_TESTFLIGHT][TESTFLIGHT_UPLOAD_COMPLETE] ipa=#{context[:ipa_path]}")

  context
rescue PrTestflightError
  raise
rescue StandardError => error
  raise PrTestflightError.new(prtf_classify_error(error, fallback: "upload"), "TestFlight upload failed: #{error.message}")
end

def prtf_completion(context)
  UI.success(
    "[PR_TESTFLIGHT][COMPLETE] version=#{context[:version]} build=#{context[:build_number]} " \
    "scheme=#{context[:scheme]} signing=#{context[:archive_signing_style] || context[:signing_style]}"
  )

  context
end

platform :ios do
  desc "Build and upload iOS app to TestFlight for PR validation"
  lane :pr_testflight do
    xcodeproj_input = ENV["IOS_XCODEPROJ"] || "GirlPower.xcodeproj"
    context = {
      xcodeproj: prtf_resolve_repo_path(xcodeproj_input),
      scheme: ENV["IOS_SCHEME"] || "GirlPower",
      app_identifier: ENV["IOS_APP_IDENTIFIER"] || "com.route25.GirlPower",
      export_method: ENV["IOS_EXPORT_METHOD"] || "app-store",
      build_output_dir: File.join(prtf_project_root, "build")
    }

    begin
      prtf_state_start("preflight_validation")
      context = prtf_preflight_validation(context)
      prtf_state_done("preflight_validation")

      prtf_state_start("version_build_prep")
      context = prtf_version_build_prep(context)
      prtf_state_done("version_build_prep")

      prtf_state_start("archive_build")
      context = prtf_archive_build(context)
      prtf_state_done("archive_build")

      prtf_state_start("upload_testflight")
      context = prtf_upload_testflight(context)
      prtf_state_done("upload_testflight")

      prtf_state_start("completion")
      prtf_completion(context)
      prtf_state_done("completion")
    rescue PrTestflightError => error
      UI.error("[PR_TESTFLIGHT][FAILED][CATEGORY=#{error.category}] #{error.message}")
      UI.user_error!("[PR_TESTFLIGHT][FAILED][CATEGORY=#{error.category}] #{error.message}")
    rescue StandardError => error
      category = prtf_refined_error_category(error, fallback: "build")
      UI.error("[PR_TESTFLIGHT][FAILED][CATEGORY=#{category}] #{error.message}")
      UI.user_error!("[PR_TESTFLIGHT][FAILED][CATEGORY=#{category}] #{error.message}")
    ensure
      prtf_cleanup(context)
    end
  end
end
